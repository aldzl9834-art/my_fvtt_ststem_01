            <div style="flex:0 0 25px; text-align:center;">장착</div>
            <div style="flex:2;">무기명</div>
            <div style="flex:1; text-align:center;">무기타입</div>
            <div style="flex:0 0 45px; text-align:center;">신뢰도</div>
            <div style="flex:1; text-align:center;">탄약</div>
            <div style="flex:0 0 40px; text-align:center;">관리</div>
          </div>

          {{#each weapons as |item|}}
          <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
            <div style="flex:0 0 25px; text-align:center;">
              <a class="item-equip" style="color:{{#if item.system.equipped}}#28a745{{else}}#ccc{{/if}};">
                <i class="{{#if item.system.equipped}}fas fa-check-square{{else}}far fa-square{{/if}}"></i>
              </a>
            </div>
            <div class="item-name item-edit" style="flex:2; font-weight:bold; cursor:pointer; color:#0056b3;">{{item.name}}</div>
            <div style="flex:1; text-align:center;">{{item.system.weaponType}}</div>
            <div style="flex:0 0 45px; text-align:center; font-weight:bold; color:#d9534f;">{{item.system.reliability}}</div>
            <div style="flex:1; text-align:center;">{{item.system.ammo.value}} / {{item.computedAmmoMax}}</div>
            <div style="flex:0 0 40px; text-align:center;">
              <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
        </div>

        <div style="flex:1; display:flex; flex-direction:column; gap:10px;">
          
          <div style="border:1px solid #ccc; padding:5px; background:#fff; border-radius:4px;">
            <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 8px 0; font-size:12px;">머리 방어구 (Head)</h3>
            <div style="display:flex; font-weight:bold; font-size:10px; color:#666; border-bottom:1px solid #ccc; padding-bottom:4px; margin-bottom:4px;">
              <div style="flex:0 0 25px; text-align:center;">장착</div>
              <div style="flex:2;">방어구명</div>
              <div style="flex:1; text-align:center;">장갑치</div>
              <div style="flex:1; text-align:center;">방어치</div>
              <div style="flex:0 0 40px; text-align:center;">관리</div>
            </div>
            {{#each headArmors as |item|}}
            <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
              <div style="flex:0 0 25px; text-align:center;">
                <a class="item-equip" style="color:{{#if item.system.equipped}}#28a745{{else}}#ccc{{/if}};">
                  <i class="{{#if item.system.equipped}}fas fa-check-square{{else}}far fa-square{{/if}}"></i>
                </a>
              </div>
              <div class="item-name item-edit" style="flex:2; font-weight:bold; cursor:pointer; color:#0056b3;">{{item.name}}</div>
              
              <div style="flex:1; text-align:center; font-size:12px; color:#d9534f; font-weight:bold;">{{item.system.armorValue}}</div>
              <div style="flex:1; text-align:center; font-size:12px; color:#0056b3; font-weight:bold;">{{item.system.defense}}</div>
              
              <div style="flex:0 0 40px; text-align:center;">
                <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            {{/each}}
          </div>

          <div style="border:1px solid #ccc; padding:5px; background:#fff; border-radius:4px;">
            <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 8px 0; font-size:12px;">몸통 방어구 (Body)</h3>
            <div style="display:flex; font-weight:bold; font-size:10px; color:#666; border-bottom:1px solid #ccc; padding-bottom:4px; margin-bottom:4px;">
              <div style="flex:0 0 25px; text-align:center;">장착</div>
              <div style="flex:2;">방어구명</div>
              <div style="flex:1; text-align:center;">장갑치</div>
              <div style="flex:1; text-align:center;">방어치</div>
              <div style="flex:0 0 40px; text-align:center;">관리</div>
            </div>
            {{#each bodyArmors as |item|}}
            <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
              <div style="flex:0 0 25px; text-align:center;">
                <a class="item-equip" style="color:{{#if item.system.equipped}}#28a745{{else}}#ccc{{/if}};">
                  <i class="{{#if item.system.equipped}}fas fa-check-square{{else}}far fa-square{{/if}}"></i>
                </a>
              </div>
              <div class="item-name item-edit" style="flex:2; font-weight:bold; cursor:pointer; color:#0056b3;">{{item.name}}</div>
              
              <div style="flex:1; text-align:center; font-size:12px; color:#d9534f; font-weight:bold;">{{item.system.armorValue}}</div>
              <div style="flex:1; text-align:center; font-size:12px; color:#0056b3; font-weight:bold;">{{item.system.defense}}</div>
              
              <div style="flex:0 0 40px; text-align:center;">
                <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            {{/each}}
          </div>

        </div>
      </div>
    </div>

    
    <div class="tab items" data-group="primary" data-tab="items" style="padding:10px;">
      
      <div style="display:flex; gap:15px; align-items:flex-start;">
        
        <div style="flex: 0 0 440px; display:flex; flex-direction:column; gap:20px;">
          
          <div>
            <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 10px 0; font-size:13px;">CP 관리표 (10 x 10)</h3>
            
            <div style="display:flex; margin-left:40px; margin-bottom:5px; align-items:center;">
              <div style="font-size:12px; font-weight:bold; color:#0056b3; margin-right:5px;">→ 크기(체격) 한계:</div>
              <input type="number" name="system.profile.inventoryMax.x" data-field="system.profile.inventoryMax.x" value="{{#if system.profile.inventoryMax.x}}{{system.profile.inventoryMax.x}}{{else}}10{{/if}}" data-dtype="Number" class="sync-input" style="width:40px; height:20px; text-align:center; font-weight:bold; border:1px solid #0056b3; border-radius:3px; background:#e8f4ff; color:#0056b3;"/>
            </div>
            
            <div style="display:flex; margin-left:40px; height:15px; margin-bottom:2px;">
              <div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">1</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">2</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">3</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">4</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">5</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">6</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">7</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">8</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">9</div><div style="width:40px; text-align:center; font-size:11px; color:#555; font-weight:bold;">10</div>
            </div>

            <div style="display:flex;">
              <div style="width:40px; display:flex; position:relative;">
                <div style="position:absolute; left:0; top:0; display:flex; flex-direction:column; align-items:center;">
                  <div style="writing-mode: vertical-rl; font-size:12px; font-weight:bold; color:#d9534f; letter-spacing: 2px;">↓ 무게(근력)</div>
                  <input type="number" name="system.profile.inventoryMax.y" data-field="system.profile.inventoryMax.y" value="{{#if system.profile.inventoryMax.y}}{{system.profile.inventoryMax.y}}{{else}}10{{/if}}" data-dtype="Number" class="sync-input" style="width:26px; height:20px; text-align:center; font-size:11px; font-weight:bold; border:1px solid #d9534f; border-radius:3px; margin-top:5px; margin-left:5px; padding:0; background:#fff4f4; color:#d9534f;"/>
                </div>
                <div style="margin-left:20px; display:flex; flex-direction:column; width:20px;">
                  <div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">1</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">2</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">3</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">4</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">5</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">6</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">7</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">8</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">9</div><div style="height:40px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#555; font-weight:bold;">10</div>
                </div>
              </div>

              <div class="cp-grid-wrapper" style="position:relative; width:400px; height:400px; background:#e8e8e8; border:2px solid #555; box-shadow:inset 0 0 10px rgba(0,0,0,0.1); flex-shrink:0;">
                <div style="display:grid; grid-template-columns: repeat(10, 40px); grid-template-rows: repeat(10, 40px); width:100%; height:100%; position:absolute; top:0; left:0; pointer-events:none;">
                  {{#each gridCells}}
                    <div style="border-right:1px solid #ccc; border-bottom:1px solid #ccc; box-sizing:border-box; background:{{#if isActive}}transparent{{else}}rgba(0, 0, 0, 0.6){{/if}};"></div>
                  {{/each}}
                </div>
                
                {{#each gridItems}}
                  <div class="cp-grid-item" data-item-id="{{id}}" draggable="true" style="position:absolute; left:{{left}}px; top:{{top}}px; width:{{w}}px; height:{{h}}px; background:rgba(0, 86, 179, 0.85); border:1px solid #002752; color:white; font-size:10px; font-weight:bold; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:grab; overflow:hidden; box-shadow:2px 2px 5px rgba(0,0,0,0.4); z-index:10; user-select:none;">
                    {{#if isWearable}}{{#if (eq type "attachment")}}<div style="color:#a2f1ff; font-size:9px; margin-bottom:2px;"><i class="fas fa-link"></i> 부착됨</div>{{/if}}{{/if}}
                    <div style="word-break:keep-all; font-size:16px;">{{gridLabel}}</div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <div>
            <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 10px 0; font-size:13px;">가방 (Bag) 4 x 4</h3>
            <div style="margin-left:60px; display:flex;">
              <div class="bag-grid-wrapper" style="position:relative; width:160px; height:160px; background:#e8e8e8; border:2px solid #555; box-shadow:inset 0 0 10px rgba(0,0,0,0.1); flex-shrink:0;">
                <div style="display:grid; grid-template-columns: repeat(4, 40px); grid-template-rows: repeat(4, 40px); width:100%; height:100%; position:absolute; top:0; left:0; pointer-events:none;">
                  {{#each bagGridCells}}
                    <div style="border-right:1px solid #ccc; border-bottom:1px solid #ccc; box-sizing:border-box; background:transparent;"></div>
                  {{/each}}
                </div>
                
                {{#each bagGridItems}}
                  <div class="cp-grid-item" data-item-id="{{id}}" draggable="true" style="position:absolute; left:{{left}}px; top:{{top}}px; width:{{w}}px; height:{{h}}px; background:rgba(40, 167, 69, 0.85); border:1px solid #1e7e34; color:white; font-size:10px; font-weight:bold; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:grab; overflow:hidden; box-shadow:2px 2px 5px rgba(0,0,0,0.4); z-index:10; user-select:none;">
                    {{#if isWearable}}{{#if (eq type "attachment")}}<div style="color:#a2f1ff; font-size:9px; margin-bottom:2px;"><i class="fas fa-link"></i> 부착됨</div>{{/if}}{{/if}}
                    <div style="word-break:keep-all; font-size:16px;">{{gridLabel}}</div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

        </div>

        <div style="flex:1; height:650px;">
          
          <div class="unplaced-item-list" style="height:100%; border:2px dashed #999; padding:10px; background:#fafafa; border-radius:4px; overflow-y:auto; position:relative; box-sizing:border-box;">
            <h4 style="margin:0 0 10px 0; color:#0056b3; border-bottom:1px solid #0056b3; padding-bottom:5px;"><i class="fas fa-box-open"></i> 보유중인 아이템</h4>
            {{#each unplacedItems}}
              <div class="unplaced-item" data-item-id="{{id}}" draggable="true" style="border:1px solid #ccc; background:#fff; padding:6px; margin-bottom:6px; border-radius:3px; cursor:grab; display:flex; justify-content:space-between; align-items:center; box-shadow:1px 1px 3px rgba(0,0,0,0.1);">
                
                <div style="display:flex; align-items:center; gap:8px; overflow:hidden;">
                  <span style="font-weight:bold; font-size:12px; color:#fff; background:#0056b3; width:20px; height:20px; display:flex; align-items:center; justify-content:center; border-radius:3px; flex-shrink:0;">{{gridLabel}}</span>
                  
                  <span style="font-weight:bold; color:#333; font-size:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="{{name}}">
                    {{#if isWearable}}{{#if (eq type "attachment")}}<i class="fas fa-link" style="color:#17a2b8; margin-right:4px;" title="무기에 부착됨"></i>{{else}}<i class="fas fa-tshirt" style="color:#28a745; margin-right:4px;" title="착용 아이템"></i>{{/if}}{{/if}}
                    {{name}}
                  </span>
                </div>
                
                <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                  <span style="font-size:11px; color:#fff; background:{{#if isWearable}}{{#if (eq type "attachment")}}#17a2b8{{else}}#28a745{{/if}}{{else}}{{#if isPlaced}}{{#if (eq gType "bag")}}#28a745{{else}}#0056b3{{/if}}{{else}}#555{{/if}}{{/if}}; padding:2px 6px; border-radius:10px;">
                    {{#if isWearable}}
                      {{#if (eq type "attachment")}}부착됨{{else}}착용중{{/if}}
                    {{else}}
                      {{#if isPlaced}}{{#if (eq gType "bag")}}가방{{else}}배치됨{{/if}}{{else}}{{portX}} x {{portY}}{{/if}}
                    {{/if}}
                  </span>
                  <a class="unplaced-item-delete" style="color:#dc3545; cursor:pointer;" title="영구 삭제"><i class="fas fa-trash"></i></a>
                </div>

              </div>
            {{/each}}
            {{#unless unplacedItems}}
              <div style="text-align:center; color:#aaa; font-size:12px; margin-top:20px;">보유중인 아이템이 없습니다.</div>
            {{/unless}}
          </div>
          
        </div>
      </div>

      <div style="display:flex; gap:15px; margin-top:15px;">
        
        <div style="flex:1; border:1px solid #ccc; background:#fff; border-radius:4px; padding:10px;">
          <h4 style="margin:0 0 10px 0; color:#dc3545; border-bottom:1px solid #dc3545; padding-bottom:5px;">
            <i class="fas fa-home"></i> 유지비
          </h4>
          <div style="display:flex; font-weight:bold; font-size:10px; color:#666; border-bottom:1px solid #eee; padding-bottom:4px; margin-bottom:4px;">
            <div style="flex:2;">아이템명</div>
            <div style="flex:1.5; text-align:center;">위치 (속성)</div>
            <div style="flex:1; text-align:center;">유지비</div>
            <div style="flex:0 0 40px; text-align:center;">관리</div>
          </div>
          {{#each upkeepItems as |item|}}
          <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
            <div class="item-name item-edit" style="flex:2; font-weight:bold; cursor:pointer; color:#0056b3;">{{item.name}}</div>
            <div style="flex:1.5; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{item.system.location}}">{{item.system.location}}</div>
            <div style="flex:1; text-align:center; color:#dc3545; font-weight:bold;">{{item.system.maintenanceCost}}</div>
            <div style="flex:0 0 40px; text-align:center;">
              <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
          {{#unless upkeepItems}}
            <div style="text-align:center; color:#aaa; font-size:11px; margin-top:10px;">등록된 유지비 항목이 없습니다.</div>
          {{/unless}}
        </div>

        <div style="flex:1; border:1px solid #ccc; background:#fff; border-radius:4px; padding:10px;">
          <h4 style="margin:0 0 10px 0; color:#17a2b8; border-bottom:1px solid #17a2b8; padding-bottom:5px;">
            <i class="fas fa-users"></i> 커넥션 (Connections)
          </h4>
          <div style="display:flex; font-weight:bold; font-size:10px; color:#666; border-bottom:1px solid #eee; padding-bottom:4px; margin-bottom:4px;">
            <div style="flex:1.5;">커넥션명</div>
            <div style="flex:1; text-align:center;">직업</div>
            <div style="flex:1.5; text-align:center;">본거지</div>
            <div style="flex:0.8; text-align:center;">유지비</div>
            <div style="flex:0 0 40px; text-align:center;">관리</div>
          </div>
          {{#each connections as |item|}}
          <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
            <div class="item-name item-edit" style="flex:1.5; font-weight:bold; cursor:pointer; color:#0056b3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{item.name}}">{{item.name}}</div>
            
            <div style="flex:1; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#444;" title="{{item.system.job}}">{{item.system.job}}</div>
            
            <div style="flex:1.5; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#666;" title="{{item.system.base}}">{{item.system.base}}</div>
            
            <div style="flex:0.8; text-align:center; color:#dc3545; font-weight:bold;">{{item.system.maintenanceCost}}</div>
            
            <div style="flex:0 0 40px; text-align:center;">
              <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
          {{#unless connections}}
            <div style="text-align:center; color:#aaa; font-size:11px; margin-top:10px;">등록된 커넥션이 없습니다.</div>
          {{/unless}}
        </div>

      </div>

    </div>

    <div class="tab class-arts" data-group="primary" data-tab="class-arts">
      <div style="padding:10px;">
        <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 10px 0; font-size:13px; display:flex; justify-content:space-between; align-items:center;">
          <span><i class="fas fa-bolt"></i> 클래스 아츠 (Class Arts)</span>
          <span style="font-size:11px; font-weight:normal; color:#aaa;">※ 최대 8개 ※</span>
        </h3>
        
        <div style="display:flex; flex-direction:column; gap:10px;">
          {{#each classArts as |art|}}
          <div class="item" data-item-id="{{art._id}}" style="border:1px solid #ccc; background:#fff; border-radius:4px; padding:10px; position:relative; box-shadow:1px 1px 3px rgba(0,0,0,0.1);">
            
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #eee; padding-bottom:5px; margin-bottom:5px;">
              <div style="display:flex; align-items:center; gap:10px;">
                <a class="item-use-toggle" style="font-size:18px; color:{{#if art.system.used}}#dc3545{{else}}#ccc{{/if}}; cursor:pointer;" title="사용 여부 토글 (클릭)">
                  <i class="fas {{#if art.system.used}}fa-check-square{{else}}fa-square{{/if}}"></i>
                </a>
                <div class="item-name item-edit" style="font-weight:bold; font-size:14px; color:#0056b3; cursor:pointer;" title="클릭하여 상세 정보 수정">{{art.name}}</div>
                {{#if art.system.artsGroup}}
                  <div style="font-size:10px; color:#fff; background:#555; padding:2px 6px; border-radius:10px;">{{lookup (lookup @root.gundogClasses art.system.artsGroup) 'label'}}</div>
                {{/if}}
              </div>
              <div style="display:flex; gap:10px;">
                <a class="item-edit" title="수정" style="color:#666; cursor:pointer;"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제" style="color:#dc3545; cursor:pointer;"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:10px; font-size:11px; margin-bottom:8px;">
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">타이밍:</span> <span style="color:#333; font-weight:bold;">{{art.system.timing}}</span></div>
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">대상:</span> <span style="color:#333; font-weight:bold;">{{art.system.target}}</span></div>
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">지속시간:</span> <span style="color:#333; font-weight:bold;">{{art.system.duration}}</span></div>
            </div>
            
            <div style="font-size:12px; color:#222; background:#fafafa; padding:8px; border:1px solid #eee; border-radius:3px; white-space:pre-wrap; line-height:1.4;">{{art.system.effect}}</div>
          </div>
          {{/each}}
          
          {{#unless classArts}}
            <div style="text-align:center; color:#aaa; font-size:12px; margin-top:30px; border:2px dashed #ccc; padding:20px; border-radius:4px;">
              등록된 클래스 아츠가 없습니다.<br>우측의 아이템 목록에서 클래스 아츠 아이템을 이 시트 위로 드래그 앤 드롭하여 추가하세요.
            </div>
          {{/unless}}
        </div>
        
      </div>
    </div>
  </section>
</form>