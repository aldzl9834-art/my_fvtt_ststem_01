<form class="gundog-sheet" autocomplete="off">

  <div class="sheet-main-content">
  
  <header class="sheet-header">
    
    <div class="portrait-container">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      <div class="name-class-overlay">
        <input class="charname-input" name="name" type="text" value="{{actor.name}}" placeholder="캐릭터 이름"/>
        <div class="class-selects">
          <select name="system.profile.mainClass" title="Main Class">
            <option value="">-- Main --</option>
            {{#each gundogClasses as |classData key|}}<option value="{{key}}" {{#if (eq ../system.profile.mainClass key)}}selected{{/if}}>{{classData.label}}</option>{{/each}}
          </select>
          <select name="system.profile.subClass" title="Sub Class">
            <option value="">-- Sub --</option>
            {{#each gundogClasses as |classData key|}}<option value="{{key}}" {{#if (eq ../system.profile.subClass key)}}selected{{/if}}>{{classData.label}}</option>{{/each}}
          </select>
        </div>
      </div>
    </div>
    
    <div class="header-fields">
      
      <div class="header-stats">

                <div class="cap-title-bar">
          
          <h2 class="cap-main-title">기본 정보</h2>
          
          <div class="cap-right-info">
            <div class="info-group">
              <span class="info-label">소속</span>
              <select name="system.profile.affiliation" class="affiliation-select" disabled>
                <option value="">-- 선택 --</option>
                {{#each gundogAffiliations as |label key|}}
                  <option value="{{key}}" {{#if (eq ../system.profile.affiliation key)}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <a class="toggle-affiliation" title="수정하려면 클릭하세요"><i class="fas fa-lock"></i></a>
            </div>
            
            <div class="info-group">
              <span class="info-label">EXP</span>
              <input type="text" class="exp-input" name="system.profile.exp.current" value="{{system.profile.exp.current}}" data-dtype="Number"/>
              <span class="exp-slash">/</span>
              <input type="text" class="exp-input" name="system.profile.exp.total" value="{{system.profile.exp.total}}" data-dtype="Number"/>
            </div>
          </div>

        </div>
        
        <div class="header-row header-row-2">
          
          <div class="stat-box hp-box">
            <label><i class="fas fa-heart"></i> 내구력</label>
            <div class="stat-inputs">
              <input type="text" name="system.profile.hp.value" value="{{system.profile.hp.value}}" data-dtype="Number"/>
              <span class="slash">/</span>
              <span class="max-val">{{system.profile.hp.max}}</span>
            </div>
          </div>
          
          <div class="stat-box movement-box">
            <label><i class="fas fa-running"></i> 이동력</label>
            <div class="movement-grid">
              <div class="move-item"><span class="move-label">신중</span><br><span class="move-val">{{system.profile.movement.careful}}</span></div>
              <div class="move-item center"><span class="move-label">일반</span><br><span class="move-val highlight">{{system.profile.movement.normal}}</span></div>
              <div class="move-item"><span class="move-label">전력질주</span><br><span class="move-val">{{system.profile.movement.sprint}}</span></div>
            </div>
          </div>

          <div class="stat-box rp-box">
            <label><i class="fas fa-star"></i> 리워드 포인트</label>
            <div class="stat-inputs">
              <input type="text" name="system.profile.rewardPoints.current" value="{{system.profile.rewardPoints.current}}" data-dtype="Number"/>
              <span class="slash">/</span>
              <div class="rp-max-container">
                <span class="rp-display" title="특징이 적용된 최종 최대치 (클릭하여 기본값 수정)">{{computedRpMax}}</span>
                <input type="text" class="rp-input" name="system.profile.rewardPoints.total" value="{{system.profile.rewardPoints.total}}" data-dtype="Number" style="display:none;"/>
              </div>
            </div>
          </div>
          
        </div>

        <div class="header-row header-row-3">
          
          <div class="money-container">
            <label style="font-size: 12px;">자산</label>
            
            <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 4px;">
              <div class="money-row">
                <label><i class="fas fa-money-bill"></i> 현금 (Cash)</label>
                <input type="text" class="comma-input cash-input" data-field="system.profile.wealth.cash" value="{{system.profile.wealth.cash}}"/>
              </div>
              <div class="money-row">
                <label><i class="fas fa-bank"></i> 예금 (Bank)</label>
                <input type="text" class="comma-input bank-input" data-field="system.profile.wealth.bank" value="{{system.profile.wealth.bank}}"/>
              </div>
            </div>
          </div>

          <div class="stat-box language-box" style="flex: 1.5;">
            <label>사용 언어 (최대 6개)</label>
            <div class="lang-grid">
              <input type="text" name="system.profile.languages.lang1" value="{{system.profile.languages.lang1}}"/>
              <input type="text" name="system.profile.languages.lang2" value="{{system.profile.languages.lang2}}"/>
              <input type="text" name="system.profile.languages.lang3" value="{{system.profile.languages.lang3}}"/>
              <input type="text" name="system.profile.languages.lang4" value="{{system.profile.languages.lang4}}"/>
              <input type="text" name="system.profile.languages.lang5" value="{{system.profile.languages.lang5}}"/>
              <input type="text" name="system.profile.languages.lang6" value="{{system.profile.languages.lang6}}"/>
            </div>
          </div>
          
        </div>

      </div>

      <div class="header-capabilities">

        <div class="capabilities-grid">
          {{#each system.capabilities as |cap key|}}
            <div class="capability-box">
              <div class="cap-name">{{lookup ../capabilityLabels key}}</div>
              <input class="cap-val-input" type="text" name="system.capabilities.{{key}}.value" value="{{cap.value}}" data-dtype="Number"/>
            </div>
          {{/each}}
        </div>
      </div>

    </div>
  </header>
     
      <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="profile" title="프로필"><i class="fas fa-id-card"></i></a>
    <a class="item" data-tab="skills" title="스킬"><i class="fas fa-brain"></i></a>
    <a class="item" data-tab="equipment" title="장비"><i class="fas fa-shield-alt"></i></a>
    <a class="item" data-tab="items" title="아이템(가방)"><i class="fas fa-box-open"></i></a>
    <a class="item" data-tab="class-arts" title="클래스 아츠"><i class="fas fa-star"></i></a>

    <a class="btn-open-smartphone" title="스마트폰 열기" style="margin-left: auto; padding: 0 15px; cursor: pointer; font-size: 20px; color: #3498db; transition: 0.2s;">
          <i class="fas fa-mobile-alt"></i>
        </a>
  </nav>

      <section class="sheet-body">

    <div class="tab profile" data-group="primary" data-tab="profile">
        
        <div class="profile-top-layout">
          
          <div class="profile-section">
            <h2 class="section-title">프로필</h2>
          
          <div class="profile-grid-2col">
            <div class="profile-field"><label>국적</label><input type="text" name="system.profile.nationality" value="{{system.profile.nationality}}"/></div>
            <div class="profile-field"><label>직업</label><input type="text" name="system.profile.occupation" value="{{system.profile.occupation}}"/></div>
            
            <div class="profile-field"><label>성별</label><input type="text" name="system.profile.gender" value="{{system.profile.gender}}"/></div>
            <div class="profile-field"><label>혈액형</label><input type="text" name="system.profile.bloodType" value="{{system.profile.bloodType}}"/></div>
            
            <div class="profile-field"><label>나이</label><input type="text" name="system.profile.age" value="{{system.profile.age}}"/></div>
            <div class="profile-field"><label>눈색</label><input type="text" name="system.profile.eyeColor" value="{{system.profile.eyeColor}}"/></div>
            
            <div class="profile-field"><label>체중</label><input type="text" name="system.profile.weight" value="{{system.profile.weight}}"/></div>
            <div class="profile-field"><label>머리색</label><input type="text" name="system.profile.hairColor" value="{{system.profile.hairColor}}"/></div>
            
            <div class="profile-field"><label>신장</label><input type="text" name="system.profile.height" value="{{system.profile.height}}"/></div>
            <div class="profile-field"><label>피부색</label><input type="text" name="system.profile.skinColor" value="{{system.profile.skinColor}}"/></div>
            
            <div class="profile-field"><label>유지비</label><input type="text" class="readonly-comma" value="{{totalMaintenanceCost}}" style="font-size:12px; color:#dc3545; border:1px solid #a5a5a5; border-radius: 4px; background-color:#ffffff00; text-align:center; font-weight:bold; pointer-events:none;"/></div>
          </div>
        </div>

        <div class="profile-section profile-right-section">
            
            <h2 class="section-title">경력 및 스킬</h2>
            
            <div class="career-bonus-container">
              
              <div class="career-group">
                <label class="group-label">경력 (최대 5개 / 클릭하여 선택)</label>
                <div class="career-list">
                  {{#each system.profile.careers as |career slotId|}}
                    <div class="career-slot" data-slot="{{slotId}}">
                      {{#if career.name}}
                        <div class="career-name">
                          {{lookup (lookup @root.careerDisplay slotId) 'label'}}
                        </div>
                        <div class="career-skills">
                          {{lookup (lookup @root.careerDisplay slotId) 'skill1'}} / {{lookup (lookup @root.careerDisplay slotId) 'skill2'}}
                        </div>
                        <a class="reset-career" data-slot="{{slotId}}" title="경력 초기화"><i class="fas fa-trash"></i></a>
                      {{else}}
                        <div class="career-empty"><i class="fas fa-plus"></i> 추가</div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </div>

              <div class="bonus-group">
                <label class="group-label">보너스 스킬 (3개 선택 / 클릭하여 추가)</label>
                <div class="bonus-skill-slot">
                  {{#if system.profile.bonusSkills.skill1}}
                    <div class="bonus-skills-text">
                      {{lookup @root.gundogSkillNames system.profile.bonusSkills.skill1}}, 
                      {{lookup @root.gundogSkillNames system.profile.bonusSkills.skill2}}, 
                      {{lookup @root.gundogSkillNames system.profile.bonusSkills.skill3}}
                    </div>
                    <a class="reset-bonus-skills" title="보너스 스킬 초기화"><i class="fas fa-trash"></i></a>
                  {{else}}
                    <div class="bonus-empty"><i class="fas fa-plus"></i> 보너스 스킬 선택</div>
                  {{/if}}
                </div>
              </div>

            </div>
          </div>
                </div>
        <hr class="section-divider">

        <div class="profile-bottom-layout">
          
          <div class="profile-section" style="padding: 15px;">
            <h2 class="section-title"><i class="fas fa-coffee" style="color:#17a2b8;"></i> 여가 행동</h2>
            
            <div class="leisure-grid">
              {{#each system.profile.leisures as |leisure slotId|}}
                <div class="leisure-slot" data-slot="{{slotId}}">
                  {{#if leisure.name}}
                    <div class="leisure-name">{{leisure.name}}</div>
                    <div class="leisure-stats">
                      <div>유지비: {{leisure.maintenanceCost}}G</div>
                      <div>여가 슬롯: {{leisure.leisureSlot}}</div>
                    </div>
                    <div class="leisure-effect" title="{{leisure.effect}}">{{leisure.effect}}</div>
                    <a class="remove-leisure" data-slot="{{slotId}}" title="여가 행동 해제"><i class="fas fa-times-circle"></i></a>
                  {{else}}
                    <div class="leisure-empty"><i class="fas fa-plus"></i>&nbsp;여가 슬롯 {{slotId}}</div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </div>

          <div class="bt-container">
            
            <div class="profile-section" style="padding: 10px 15px; display: flex; flex-direction: column; flex: 1;">
              <h2 class="section-title" style="margin-bottom: 8px;">신념</h2>
              <div class="bt-list">
                {{#each beliefs as |item|}}
                <div class="item flexrow bt-item" data-item-id="{{item._id}}">
                  <div class="bt-header">
                    <span class="item-name item-edit bt-name" title="[상세 설정] {{item.system.details}}">{{item.name}}</span>
                    <div class="bt-controls">
                      <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
                      <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                  {{#if item.system.description}}
                  <div class="bt-desc">{{item.system.description}}</div>
                  {{/if}}
                </div>
                {{/each}}
                {{#unless beliefs}}<div class="bt-empty">드래그하여 추가</div>{{/unless}}
              </div>
            </div>

            <div class="profile-section" style="padding: 10px 15px; display: flex; flex-direction: column; flex: 1;">
              <h2 class="section-title" style="margin-bottom: 8px;">특징</h2>
              <div class="bt-list">
                {{#each traits as |item|}}
                <div class="item flexrow bt-item" data-item-id="{{item._id}}">
                  <div class="bt-header">
                    <span class="item-name item-edit bt-name" title="[상세 설정] {{item.system.details}}">{{item.name}}</span>
                    <div class="bt-controls">
                      <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
                      <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                  <div class="trait-stats">
                    <div><span style="font-weight:bold; color:#17a2b8;">RP 수정:</span> {{item.system.rpModifier}}</div>
                    <div><span style="font-weight:bold; color:#dc3545;">유지 코스트:</span> {{item.system.maintenanceCost}}</div>
                  </div>
                  {{#if item.system.description}}
                  <div class="bt-desc trait">{{item.system.description}}</div>
                  {{/if}}
                </div>
                {{/each}}
                {{#unless traits}}<div class="bt-empty">드래그하여 추가</div>{{/unless}}
              </div>
            </div>

          </div>
        </div>

        <hr class="section-divider">

            <div class="profile-text-group">
          <label class="profile-text-label">백 스토리 (Backstory)</label>
          <textarea class="profile-textarea backstory-input" name="system.profile.backstory">{{system.profile.backstory}}</textarea>
        </div>

        <div class="profile-text-group notes-group">
          <label class="profile-text-label">기타 특이 사항 (Notes)</label>
          <textarea class="profile-textarea notes-input" name="system.profile.notes">{{system.profile.notes}}</textarea>
        </div>
      </div>

      <div class="tab skills" data-group="primary" data-tab="skills">
      <div class="skills-container">
        {{#each system.skills as |group groupKey|}}
          <div class="skill-group">
            
            <h3 class="skill-group-title">{{lookup @root.gundogGroupNames groupKey}}</h3>
            
            <div class="skill-list">
              {{#each group as |skill skillKey|}}
                <div class="skill-row">
                  
                  <a class="skill-name roll-skill" data-group="{{groupKey}}" data-skill="{{skillKey}}" title="클릭하여 판정 굴림">
                    <span class="skill-bullet">•</span> <span class="s-name">{{lookup @root.gundogSkillNames skillKey}}</span>
                  </a>
                  
                  <div class="skill-lv">
                    <label>Lv</label>
                    <input type="text" name="system.skills.{{groupKey}}.{{skillKey}}.lv" value="{{skill.lv}}" data-dtype="Number" />
                  </div>
                  
                  <div class="skill-item-mod" title="장비/아이템 수정치">
                    <label>Item</label>
                    <div class="mod-val">{{skill.itemMod}}</div>
                  </div>
                  
                  <div class="skill-target-value">
                    <label>성공률</label>
                    <strong>{{skill.targetValue}}</strong>
                  </div>
                  
                </div>
              {{/each}}
              </div>
          </div>
        {{/each}}
      </div>
    </div>


  <div class="tab equipment" data-group="primary" data-tab="equipment">
      <div class="equip-layout">

        <div class="equip-col">
          
          <div class="equip-slot equip-main weapon-equip-slot" data-slot="main">
            <h3 class="equip-header"><i class="fas fa-crosshairs"></i> 메인 무기 (Main Weapon)</h3>
            
            <div class="equip-table-header">
              <div class="w-name">무기명</div><div class="w-stat">신뢰성</div><div class="w-ammo">탄약</div><div class="w-action">해제</div>
            </div>

            {{#each mainWeapons as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" title="더블클릭하여 상세 보기">
              <div class="item-name w-name">{{item.name}}</div>
              <div class="w-stat">{{item.system.reliability}}</div>
              <div class="w-ammo">{{item.system.ammo.value}} <span>/ {{item.finalMaxAmmo}}</span></div>
              <div class="w-action"><a class="unequip-btn" data-item-id="{{item._id}}" title="해제"><i class="fas fa-times-circle"></i></a></div>
            </div>
            {{else}}
            <div class="equip-empty"><i class="fas fa-arrow-down"></i> 소지 무기를 이곳으로 드래그</div>
            {{/each}}
          </div>

          <div class="equip-slot equip-sub weapon-equip-slot" data-slot="sub">
            <h3 class="equip-header"><i class="fas fa-crosshairs"></i> 서브 무기 (Sub Weapon)</h3>
            
            <div class="equip-table-header">
              <div class="w-name">무기명</div><div class="w-stat">신뢰성</div><div class="w-ammo">탄약</div><div class="w-action">해제</div>
            </div>

            {{#each subWeapons as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" title="더블클릭하여 상세 보기">
              <div class="item-name w-name">{{item.name}}</div>
              <div class="w-stat">{{item.system.reliability}}</div>
              <div class="w-ammo">{{item.system.ammo.value}} <span>/ {{item.finalMaxAmmo}}</span></div>
              <div class="w-action"><a class="unequip-btn" data-item-id="{{item._id}}" title="해제"><i class="fas fa-times-circle"></i></a></div>
            </div>
            {{else}}
            <div class="equip-empty"><i class="fas fa-arrow-down"></i> 소지 무기를 이곳으로 드래그</div>
            {{/each}}
          </div>

          <div class="equip-slot equip-inv">
            <h3 class="equip-header"><i class="fas fa-toolbox"></i> 소지 무기 목록 <span style="font-size:10px; font-weight:normal; color:#aaa;">(드래그하여 장착)</span></h3>
            
            <div class="equip-table-header">
              <div class="w-name">무기명</div><div class="w-stat">신뢰성</div><div class="w-ammo">탄약</div><div class="w-action">관리</div>
            </div>

            {{#each inventoryWeapons as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" draggable="true" title="더블클릭하여 상세 보기">
              <div class="item-name w-name">{{item.name}}</div>
              <div class="w-stat">{{item.system.reliability}}</div>
              <div class="w-ammo">{{item.system.ammo.value}} <span>/ {{item.finalMaxAmmo}}</span></div>
              <div class="w-action">
                <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            {{/each}}
          </div>

        </div>

        <div class="equip-col">
          
          <div class="equip-slot equip-head armor-equip-slot" data-slot="head">
            <h3 class="equip-header"><i class="fas fa-hard-hat"></i> 머리 방어구 (Head)</h3>
            
            <div class="equip-table-header">
              <div class="w-equip">장착</div><div class="w-name" style="padding-left:0;">방어구명</div><div class="w-stat">장갑치</div><div class="w-stat">방어치</div><div class="w-action">해제</div>
            </div>
            
            {{#each headArmors as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" title="더블클릭하여 상세 보기">
              <div class="w-equip">
                <a class="item-equip {{#if item.system.equipped}}is-equipped{{/if}}">
                  <i class="{{#if item.system.equipped}}fas fa-check-square{{else}}far fa-square{{/if}}"></i>
                </a>
              </div>
              <div class="item-name w-name" style="padding-left:0;">{{item.name}}</div>
              <div class="w-stat stat-armor">{{item.system.armorValue}}</div>
              <div class="w-stat stat-defense">{{item.system.defense}}</div>
              <div class="w-action"><a class="unequip-armor-btn" data-item-id="{{item._id}}" title="해제"><i class="fas fa-times-circle"></i></a></div>
            </div>
            {{else}}
            <div class="equip-empty"><i class="fas fa-arrow-down"></i> 소지 방어구를 이곳으로 드래그</div>
            {{/each}}
          </div>

          <div class="equip-slot equip-body armor-equip-slot" data-slot="body">
            <h3 class="equip-header"><i class="fas fa-shield-alt"></i> 몸통 방어구 (Body)</h3>
            
            <div class="equip-table-header">
              <div class="w-equip">장착</div><div class="w-name" style="padding-left:0;">방어구명</div><div class="w-stat">장갑치</div><div class="w-stat">방어치</div><div class="w-action">해제</div>
            </div>
            
            {{#each bodyArmors as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" title="더블클릭하여 상세 보기">
              <div class="w-equip">
                <a class="item-equip {{#if item.system.equipped}}is-equipped{{/if}}">
                  <i class="{{#if item.system.equipped}}fas fa-check-square{{else}}far fa-square{{/if}}"></i>
                </a>
              </div>
              <div class="item-name w-name" style="padding-left:0;">{{item.name}}</div>
              <div class="w-stat stat-armor">{{item.system.armorValue}}</div>
              <div class="w-stat stat-defense">{{item.system.defense}}</div>
              <div class="w-action"><a class="unequip-armor-btn" data-item-id="{{item._id}}" title="해제"><i class="fas fa-times-circle"></i></a></div>
            </div>
            {{else}}
            <div class="equip-empty"><i class="fas fa-arrow-down"></i> 소지 방어구를 이곳으로 드래그</div>
            {{/each}}
          </div>

          <div class="equip-slot equip-inv">
            <h3 class="equip-header"><i class="fas fa-toolbox"></i> 소지 방어구 목록 <span style="font-size:10px; font-weight:normal; color:#aaa;">(드래그하여 장착)</span></h3>
            
            <div class="equip-table-header">
              <div class="w-name">방어구명</div><div class="w-stat">장갑치</div><div class="w-stat">방어치</div><div class="w-action">관리</div>
            </div>
            
            {{#each inventoryArmors as |item|}}
            <div class="item flexrow equip-item" data-item-id="{{item._id}}" draggable="true" title="더블클릭하여 상세 보기">
              <div class="item-name w-name">{{item.name}}</div>
              <div class="w-stat stat-armor">{{item.system.armorValue}}</div>
              <div class="w-stat stat-defense">{{item.system.defense}}</div>
              <div class="w-action">
                <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            {{/each}}
          </div>

        </div>

      </div>
    </div>
    
    <div class="tab items" data-group="primary" data-tab="items">
      
      <div class="item-top-layout">
        
        <div class="item-grid-section">
          
          <div>
            <h3>CP 관리표 (10 x 10)</h3>
            
            <div class="cp-controls">
              <label>→ 크기(체격) 한계:</label>
              <input type="number" name="system.profile.inventoryMax.x" data-field="system.profile.inventoryMax.x" value="{{#if system.profile.inventoryMax.x}}{{system.profile.inventoryMax.x}}{{else}}10{{/if}}" data-dtype="Number" class="sync-input" />
            </div>
            
            <div class="grid-ruler-x">
              <div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div><div>7</div><div>8</div><div>9</div><div>10</div>
            </div>

            <div class="grid-layout-main">
              <div class="grid-ruler-y-container">
                <div class="grid-ruler-y-label">
                  <span>↓ 무게(근력)</span>
                  <input type="number" name="system.profile.inventoryMax.y" data-field="system.profile.inventoryMax.y" value="{{#if system.profile.inventoryMax.y}}{{system.profile.inventoryMax.y}}{{else}}10{{/if}}" data-dtype="Number" class="sync-input" />
                </div>
                <div class="grid-ruler-y-numbers">
                  <div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div><div>7</div><div>8</div><div>9</div><div>10</div>
                </div>
              </div>

              <div class="grid-wrapper cp-grid-wrapper">
                <div class="grid-bg cp-grid-bg">
                  {{#each gridCells}}
                    <div class="grid-cell" style="background:{{#if isActive}}transparent{{else}}rgba(0, 0, 0, 0.6){{/if}};"></div>
                  {{/each}}
                </div>
                
                {{#each gridItems}}
                  <div class="cp-grid-item grid-item-block cp-item" data-item-id="{{id}}" draggable="true" style="left:{{left}}px; top:{{top}}px; width:{{w}}px; height:{{h}}px;">
                    {{#if isWearable}}{{#if (eq type "attachment")}}<div class="grid-item-attach"><i class="fas fa-link"></i> 부착됨</div>{{/if}}{{/if}}
                    <div class="grid-item-name">{{gridLabel}}</div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <div>
            <h3>가방 (Bag) 4 x 4</h3>
            <div class="grid-wrapper bag-grid-wrapper">
              <div class="grid-bg bag-grid-bg">
                {{#each bagGridCells}}
                  <div class="grid-cell" style="background:transparent;"></div>
                {{/each}}
              </div>
              
              {{#each bagGridItems}}
                <div class="cp-grid-item grid-item-block bag-item" data-item-id="{{id}}" draggable="true" style="left:{{left}}px; top:{{top}}px; width:{{w}}px; height:{{h}}px;">
                  {{#if isWearable}}{{#if (eq type "attachment")}}<div class="grid-item-attach"><i class="fas fa-link"></i> 부착됨</div>{{/if}}{{/if}}
                  <div class="grid-item-name">{{gridLabel}}</div>
                </div>
              {{/each}}
            </div>
          </div>

        </div>

        <div class="unplaced-list-container">
          <h4 class="unplaced-title"><i class="fas fa-box-open"></i> 보유중인 아이템</h4>
          {{#each unplacedItems}}
            <div class="unplaced-item" data-item-id="{{id}}" draggable="true">
              
              <div class="unplaced-item-left">
                <span class="unplaced-size-badge">{{gridLabel}}</span>
                <span class="unplaced-name" title="{{name}}">
                  {{#if isWearable}}{{#if (eq type "attachment")}}<i class="fas fa-link" style="color:#17a2b8; margin-right:4px;" title="무기에 부착됨"></i>{{else}}<i class="fas fa-tshirt" style="color:#28a745; margin-right:4px;" title="착용 아이템"></i>{{/if}}{{/if}}
                  {{name}}
                </span>
              </div>
              
              <div class="unplaced-controls">
                <span class="unplaced-status-badge" style="background:{{#if isWearable}}{{#if (eq type "attachment")}}#17a2b8{{else}}#28a745{{/if}}{{else}}{{#if isPlaced}}{{#if (eq gType "bag")}}#28a745{{else}}#0056b3{{/if}}{{else}}#555{{/if}}{{/if}};">
                  {{#if isWearable}}
                    {{#if (eq type "attachment")}}부착됨{{else}}착용중{{/if}}
                  {{else}}
                    {{#if isPlaced}}{{#if (eq gType "bag")}}가방{{else}}배치됨{{/if}}{{else}}{{portX}} x {{portY}}{{/if}}
                  {{/if}}
                </span>
                <a class="unplaced-item-delete" title="영구 삭제"><i class="fas fa-trash"></i></a>
              </div>

            </div>
          {{/each}}
          {{#unless unplacedItems}}
            <div class="b-empty">보유중인 아이템이 없습니다.</div>
          {{/unless}}
        </div>

      </div>

      <div class="item-bottom-layout">
        
        <div class="bottom-box upkeep-box">
          <h4><i class="fas fa-home"></i> 유지비</h4>
          <div class="b-table-header">
            <div style="flex:2;">아이템명</div><div style="flex:1.5; text-align:center;">위치 (속성)</div><div style="flex:1; text-align:center;">유지비</div><div style="flex:0 0 40px; text-align:center;">관리</div>
          </div>
          {{#each upkeepItems as |item|}}
          <div class="item flexrow b-table-row" data-item-id="{{item._id}}">
            <div class="item-name item-edit b-name" style="flex:2;">{{item.name}}</div>
            <div class="b-text" style="flex:1.5;" title="{{item.system.location}}">{{item.system.location}}</div>
            <div class="b-cost" style="flex:1;">{{item.system.maintenanceCost}}</div>
            <div class="b-action" style="flex:0 0 40px;">
              <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
          {{#unless upkeepItems}}<div class="b-empty">등록된 유지비 항목이 없습니다.</div>{{/unless}}
        </div>

        <div class="bottom-box conn-box">
          <h4><i class="fas fa-users"></i> 커넥션 (Connections)</h4>
          <div class="b-table-header">
            <div style="flex:1.5;">커넥션명</div><div style="flex:1; text-align:center;">직업</div><div style="flex:1.5; text-align:center;">본거지</div><div style="flex:0.8; text-align:center;">유지비</div><div style="flex:0 0 40px; text-align:center;">관리</div>
          </div>
          {{#each connections as |item|}}
          <div class="item flexrow b-table-row" data-item-id="{{item._id}}">
            <div class="item-name item-edit b-name" style="flex:1.5;" title="{{item.name}}">{{item.name}}</div>
            <div class="b-text" style="flex:1;" title="{{item.system.job}}">{{item.system.job}}</div>
            <div class="b-text" style="flex:1.5;" title="{{item.system.base}}">{{item.system.base}}</div>
            <div class="b-cost" style="flex:0.8;">{{item.system.maintenanceCost}}</div>
            <div class="b-action" style="flex:0 0 40px;">
              <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
          {{#unless connections}}<div class="b-empty">등록된 커넥션이 없습니다.</div>{{/unless}}
        </div>

      </div>

    </div>

    <div class="tab class-arts" data-group="primary" data-tab="class-arts">
      <div class="arts-container">
        
        <h3 class="arts-header">
          <span><i class="fas fa-star" style="color:#fff; margin-right:5px;"></i> 클래스 아츠 (Class Arts)</span>
          <span class="arts-header-limit">※ 최대 8개 ※</span>
        </h3>
        
        <div class="arts-list">
          {{#each classArts as |art|}}
          <div class="item art-card" data-item-id="{{art._id}}">
            
            <div class="art-card-header">
              <div class="art-card-title-group">
                <a class="item-use-toggle art-use-toggle {{#if art.system.used}}is-used{{else}}not-used{{/if}}" title="사용 여부 토글 (클릭)">
                  <i class="fas {{#if art.system.used}}fa-check-square{{else}}fa-square{{/if}}"></i>
                </a>
                
                <div class="item-name item-edit art-name" title="클릭하여 상세 정보 수정">{{art.name}}</div>
                
                {{#if art.system.artsGroup}}
                  <div class="art-group-tag">{{lookup (lookup @root.gundogClasses art.system.artsGroup) 'label'}}</div>
                {{/if}}
              </div>
              
              <div class="art-card-controls">
                <a class="item-edit" title="수정"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            
            <div class="art-stats-grid">
              <div class="art-stat-box">
                <span class="art-stat-label">타이밍:</span> <span class="art-stat-val">{{art.system.timing}}</span>
              </div>
              <div class="art-stat-box">
                <span class="art-stat-label">대상:</span> <span class="art-stat-val">{{art.system.target}}</span>
              </div>
              <div class="art-stat-box">
                <span class="art-stat-label">지속시간:</span> <span class="art-stat-val">{{art.system.duration}}</span>
              </div>
            </div>
            
            <div class="art-effect-box">{{art.system.effect}}</div>
            
          </div>
          {{/each}}
          
          {{#unless classArts}}
            <div class="art-empty-box">
              <i class="fas fa-folder-open"></i>
              등록된 클래스 아츠가 없습니다.<br>
              <strong style="color:#555;">우측의 아이템 탭</strong>이나 <strong style="color:#555;">아이템 목록창</strong>에서 클래스 아츠 아이템을<br>
              이 시트 위로 드래그 앤 드롭하여 추가하세요.
            </div>
          {{/unless}}
        </div>
        
      </div>
    </div>
  </section>

  </div>
</form>