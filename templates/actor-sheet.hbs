          {{#each connections as |item|}}
          <div class="item flexrow" data-item-id="{{item._id}}" style="display:flex; font-size:11px; align-items:center; border-bottom:1px solid #eee; padding:4px 0;">
            <div class="item-name item-edit" style="flex:1.5; font-weight:bold; cursor:pointer; color:#0056b3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{item.name}}">{{item.name}}</div>
            
            <div style="flex:1; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#444;" title="{{item.system.job}}">{{item.system.job}}</div>
            
            <div style="flex:1.5; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#666;" title="{{item.system.base}}">{{item.system.base}}</div>
            
            <div style="flex:0.8; text-align:center; color:#dc3545; font-weight:bold;">{{item.system.maintenanceCost}}</div>
            
            <div style="flex:0 0 40px; text-align:center;">
              <a class="item-edit" title="수정" style="color:#666; margin-right:4px;"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="삭제" style="color:#dc3545;"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{/each}}
          {{#unless connections}}
            <div style="text-align:center; color:#aaa; font-size:11px; margin-top:10px;">등록된 커넥션이 없습니다.</div>
          {{/unless}}
        </div>

      </div>

    </div>

    <div class="tab class-arts" data-group="primary" data-tab="class-arts">
      <div style="padding:10px;">
        <h3 style="background:#222; color:white; padding:4px 8px; margin:0 0 10px 0; font-size:13px; display:flex; justify-content:space-between; align-items:center;">
          <span><i class="fas fa-bolt"></i> 클래스 아츠 (Class Arts)</span>
          <span style="font-size:11px; font-weight:normal; color:#aaa;">※ 최대 8개 ※</span>
        </h3>
        
        <div style="display:flex; flex-direction:column; gap:10px;">
          {{#each classArts as |art|}}
          <div class="item" data-item-id="{{art._id}}" style="border:1px solid #ccc; background:#fff; border-radius:4px; padding:10px; position:relative; box-shadow:1px 1px 3px rgba(0,0,0,0.1);">
            
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #eee; padding-bottom:5px; margin-bottom:5px;">
              <div style="display:flex; align-items:center; gap:10px;">
                <a class="item-use-toggle" style="font-size:18px; color:{{#if art.system.used}}#dc3545{{else}}#ccc{{/if}}; cursor:pointer;" title="사용 여부 토글 (클릭)">
                  <i class="fas {{#if art.system.used}}fa-check-square{{else}}fa-square{{/if}}"></i>
                </a>
                <div class="item-name item-edit" style="font-weight:bold; font-size:14px; color:#0056b3; cursor:pointer;" title="클릭하여 상세 정보 수정">{{art.name}}</div>
                {{#if art.system.artsGroup}}
                  <div style="font-size:10px; color:#fff; background:#555; padding:2px 6px; border-radius:10px;">{{lookup (lookup @root.gundogClasses art.system.artsGroup) 'label'}}</div>
                {{/if}}
              </div>
              <div style="display:flex; gap:10px;">
                <a class="item-edit" title="수정" style="color:#666; cursor:pointer;"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="삭제" style="color:#dc3545; cursor:pointer;"><i class="fas fa-trash"></i></a>
              </div>
            </div>
            
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:10px; font-size:11px; margin-bottom:8px;">
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">타이밍:</span> <span style="color:#333; font-weight:bold;">{{art.system.timing}}</span></div>
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">대상:</span> <span style="color:#333; font-weight:bold;">{{art.system.target}}</span></div>
              <div style="background:#f4f4f4; padding:4px; border-radius:3px; text-align:center;"><span style="color:#666; font-weight:bold;">지속시간:</span> <span style="color:#333; font-weight:bold;">{{art.system.duration}}</span></div>
            </div>
            
            <div style="font-size:12px; color:#222; background:#fafafa; padding:8px; border:1px solid #eee; border-radius:3px; white-space:pre-wrap; line-height:1.4;">{{art.system.effect}}</div>
          </div>
          {{/each}}
          
          {{#unless classArts}}
            <div style="text-align:center; color:#aaa; font-size:12px; margin-top:30px; border:2px dashed #ccc; padding:20px; border-radius:4px;">
              등록된 클래스 아츠가 없습니다.<br>우측의 아이템 목록에서 클래스 아츠 아이템을 이 시트 위로 드래그 앤 드롭하여 추가하세요.
            </div>
          {{/unless}}
        </div>
        
      </div>
    </div>
  </section>

  </div>
</form>