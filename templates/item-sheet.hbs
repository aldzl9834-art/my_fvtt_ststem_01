<form class="gundog-item-sheet" autocomplete="off" style="padding: 10px; background: #f9f9f9; height: 100%; overflow-y:auto;">
  
  <header class="sheet-header" style="display:flex; margin-bottom:15px; padding-bottom:10px; border-bottom:2px solid #222; position:relative; min-height:170px;">
    
    <div class="header-bg-image">
      <img src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    </div>

    <div class="header-fields" style="flex:1; display:flex; flex-direction:column; justify-content:center; position:relative;">
      
      <div class="lock-toggle-container">
        <span style="font-size: 11px; font-weight: bold; color: #555; margin-right: 6px;">잠금</span>
        <a class="toggle-item-lock {{#if system.locked}}is-locked{{/if}}" title="시트 잠금/해제">
          <div class="switch-track">
            <div class="switch-knob"></div>
            <span class="switch-text">{{#if system.locked}}ON{{else}}OFF{{/if}}</span>
          </div>
        </a>
      </div>

      <h1 class="charname" style="margin:0;">
        <input name="name" type="text" value="{{item.name}}" placeholder="아이템 이름" style="font-family:'VITRO_CORE_OTF', sans-serif; font-weight:bold; font-size:24px; border:none; background:transparent; width:100%;"/>
      </h1>

      <div class="header-details-grid">
        
        <div class="item-type-row">
          <span>아이템 타입: {{item.type}}</span>
        </div>
        
        {{#unless isClassArts}}
        {{#unless isBelief}}
        {{#unless isTrait}}
        {{#unless isLeisure}}
        
        <div class="grid-label">가격</div>
        <div class="grid-input">
          <input type="text" class="comma-input" data-field="system.price" value="{{formattedPrice}}" style="width:100%; text-align:center;" />
        </div>
        
        <div class="grid-label">입수치</div>
        <div class="grid-input">
          <input type="text" name="system.availability" value="{{system.availability}}" />
        </div>
        {{/unless}}
        {{/unless}}
        {{/unless}}
        {{/unless}}

        {{#if isWeapon}}
        <div class="grid-label">탄창 가격</div>
        <div class="grid-input flex-input">
          <input type="number" name="system.ammoPrice" value="{{system.ammoPrice}}" />
          {{#if computed.showFinalAmmoPrice}}
            <span class="final-ammo-price">(최종: {{computed.finalAmmoPrice}})</span>
          {{/if}}
        </div>
        
        <div class="grid-label">입수치</div>
        <div class="grid-input">
          <input type="text" name="system.ammoAvailability" value="{{system.ammoAvailability}}" />
        </div>
        {{/if}}
      </div>
  
  </header>

  <div class="sheet-body" style="border:1px solid #ccc; padding:10px; background:#fff; border-radius:4px;">
    
    {{#if isWeapon}}
      <h3 style="background:#222; color:white; padding:4px 8px; font-size:13px; margin:0 0 10px 0;">무기 프로필</h3>
      
      <div class="split-grid" style="margin-bottom:15px;">
        <label>무기 분류</label>
        <input class="box-style" type="text" name="system.weaponType" value="{{system.weaponType}}"/>
        
        <label class="right-label">사용 스킬</label>
        <select class="box-style" name="system.skill">
            <option value="handgun" {{#if (eq system.skill "handgun")}}selected{{/if}}>핸드건</option>
            <option value="smg" {{#if (eq system.skill "smg")}}selected{{/if}}>기관단총</option>
            <option value="rifle" {{#if (eq system.skill "rifle")}}selected{{/if}}>라이플</option>
            <option value="heavyWeaponry" {{#if (eq system.skill "heavyWeaponry")}}selected{{/if}}>중화기</option>
            <option value="sniping" {{#if (eq system.skill "sniping")}}selected{{/if}}>저격</option>
            <option value="fighting" {{#if (eq system.skill "fighting")}}selected{{/if}}>격투</option>
            <option value="meleeCombat" {{#if (eq system.skill "meleeCombat")}}selected{{/if}}>무기전투</option>
            <option value="throwing" {{#if (eq system.skill "throwing")}}selected{{/if}}>투척</option>
            <option value="mechanics" {{#if (eq system.skill "mechanics")}}selected{{/if}}>메카닉</option>
            <option value="explosives" {{#if (eq system.skill "explosives")}}selected{{/if}}>폭발물</option>
        </select>
      </div>

      <div class="split-grid" style="margin-bottom:10px;">
        <label>사격 모드</label>
        <input class="box-style" type="text" name="system.firingMode" value="{{system.firingMode}}" placeholder="단발, 3점사 등"/>
        
        <label class="right-label">신뢰성</label>
        <div class="flex-container">
          <input class="box-style" type="text" name="system.reliability" value="{{system.reliability}}"/>
          <span class="suffix">{{{computed.relStr}}}</span>
        </div>

        <label>사정거리</label>
        <div class="flex-container">
            <input class="box-style" type="text" name="system.range" value="{{system.range}}"/>
            <span class="suffix">m</span>
        </div>
        
        <label class="right-label">소음 레벨</label>
        <div class="flex-container">
          <input class="box-style" type="text" name="system.noiseLevel" value="{{system.noiseLevel}}"/>
          <span class="suffix">{{{computed.noiseStr}}}</span>
        </div>
      </div>

      <div class="split-grid" style="margin-bottom:15px; padding-bottom:20px; border-bottom:1px dashed #ccc;">
        <label>필요 근력</label>
        <div class="flex-container multi-input">
          <span style="font-size:10px; color:#666;">한손</span>
          <input class="box-style" type="text" name="system.requiredStr.oneHand" value="{{system.requiredStr.oneHand}}"/>
          <span style="font-size:10px; color:#666;">양손</span>
          <input class="box-style" type="text" name="system.requiredStr.twoHands" value="{{system.requiredStr.twoHands}}"/>
        </div>
        
        <label class="right-label">휴대치</label>
        <div class="flex-container multi-input">
          <input class="box-style" type="text" name="system.portability.x" value="{{system.portability.x}}"/>
          <span style="font-size:10px; color:#666; font-weight:bold;">X</span>
          <input class="box-style" type="text" name="system.portability.y" value="{{system.portability.y}}"/>
        </div>
      </div>

      <h4 style="margin:15px 0 5px 0; font-size:12px; color:#0056b3; border-bottom:1px solid #ccc; padding-bottom:6px;"><i class="fas fa-crosshairs"></i> 거리별 명중 수정치</h4>
      <div style="display:grid; grid-template-columns: repeat(5, 1fr); gap:2px; text-align:center; font-size:12px; margin-bottom:15px;">
        <div style="background:#eee; font-weight:bold; border:1px solid #ccc; padding:4px 0;">지근거리</div>
        <div style="background:#eee; font-weight:bold; border:1px solid #ccc; padding:4px 0;">근거리</div>
        <div style="background:#eee; font-weight:bold; border:1px solid #ccc; padding:4px 0;">중거리</div>
        <div style="background:#eee; font-weight:bold; border:1px solid #ccc; padding:4px 0;">장거리</div>
        <div style="background:#eee; font-weight:bold; border:1px solid #ccc; padding:4px 0; color:#17a2b8;">저격</div>

        <div style="border:1px solid #ccc; background:#f4f8ff; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:blue; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangeBuffs.pointBlank}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.buffs.pointBlank" value="{{system.rangeModifiers.buffs.pointBlank}}" style="display:none; width:100%; height:100%; text-align:center; color:blue; font-weight:bold; border:1px solid #b8daff; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#f4f8ff; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:blue; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangeBuffs.short}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.buffs.short" value="{{system.rangeModifiers.buffs.short}}" style="display:none; width:100%; height:100%; text-align:center; color:blue; font-weight:bold; border:1px solid #b8daff; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#f4f8ff; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:blue; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangeBuffs.medium}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.buffs.medium" value="{{system.rangeModifiers.buffs.medium}}" style="display:none; width:100%; height:100%; text-align:center; color:blue; font-weight:bold; border:1px solid #b8daff; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#f4f8ff; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:blue; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangeBuffs.long}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.buffs.long" value="{{system.rangeModifiers.buffs.long}}" style="display:none; width:100%; height:100%; text-align:center; color:blue; font-weight:bold; border:1px solid #b8daff; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#f4f8ff; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:blue; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangeBuffs.sniping}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.buffs.sniping" value="{{system.rangeModifiers.buffs.sniping}}" style="display:none; width:100%; height:100%; text-align:center; color:blue; font-weight:bold; border:1px solid #b8daff; outline:none;"/>
        </div>

        <div style="border:1px solid #ccc; background:#fff4f4; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:red; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangePenalties.pointBlank}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.penalties.pointBlank" value="{{system.rangeModifiers.penalties.pointBlank}}" style="display:none; width:100%; height:100%; text-align:center; color:red; font-weight:bold; border:1px solid #f5c6cb; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#fff4f4; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:red; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangePenalties.short}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.penalties.short" value="{{system.rangeModifiers.penalties.short}}" style="display:none; width:100%; height:100%; text-align:center; color:red; font-weight:bold; border:1px solid #f5c6cb; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#fff4f4; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:red; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangePenalties.medium}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.penalties.medium" value="{{system.rangeModifiers.penalties.medium}}" style="display:none; width:100%; height:100%; text-align:center; color:red; font-weight:bold; border:1px solid #f5c6cb; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#fff4f4; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:red; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangePenalties.long}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.penalties.long" value="{{system.rangeModifiers.penalties.long}}" style="display:none; width:100%; height:100%; text-align:center; color:red; font-weight:bold; border:1px solid #f5c6cb; outline:none;"/>
        </div>
        <div style="border:1px solid #ccc; background:#fff4f4; padding:2px; height:24px; display:flex; align-items:center; justify-content:center;">
          <span class="mod-display" title="클릭하여 기본값 수정" style="color:red; font-weight:bold; cursor:pointer; width:100%; text-align:center;">{{computed.rangePenalties.sniping}}</span>
          <input type="text" class="mod-input comma-input" data-field="system.rangeModifiers.penalties.sniping" value="{{system.rangeModifiers.penalties.sniping}}" style="display:none; width:100%; height:100%; text-align:center; color:red; font-weight:bold; border:1px solid #f5c6cb; outline:none;"/>
        </div>
        <a class="roll-weapon" data-range="pointBlank" style="background:#222; color:white; padding:4px 0; border-radius:2px; cursor:pointer;"><i class="fas fa-dice"></i> 판정</a>
        <a class="roll-weapon" data-range="short" style="background:#222; color:white; padding:4px 0; border-radius:2px; cursor:pointer;"><i class="fas fa-dice"></i> 판정</a>
        <a class="roll-weapon" data-range="medium" style="background:#222; color:white; padding:4px 0; border-radius:2px; cursor:pointer;"><i class="fas fa-dice"></i> 판정</a>
        <a class="roll-weapon" data-range="long" style="background:#222; color:white; padding:4px 0; border-radius:2px; cursor:pointer;"><i class="fas fa-dice"></i> 판정</a>
        <a class="roll-weapon" data-range="sniping" style="background:#17a2b8; color:white; padding:4px 0; border-radius:2px; cursor:pointer;"><i class="fas fa-dice"></i> 판정</a>
      </div>

      <div style="display:grid; grid-template-columns: 80px 1fr 80px 1fr; gap:8px; align-items:center; margin-bottom:10px; padding:10px; background:#fefefe; border:1px dashed #ccc; border-radius:4px;">
        
        <label style="font-weight:bold; font-size:12px; color:#d9534f;">관통력 (AP)</label>
        <div style="display:flex; align-items:center; border:1px solid #bbb; background:#fff; border-radius:3px; height:24px;">
          <input type="text" name="system.armorPiercing" value="{{system.armorPiercing}}" style="border:none; background:transparent; width:100%; text-align:center; font-weight:bold; color:#d9534f; height:100%; outline:none;"/>
          <span style="font-weight:bold; font-size:11px; padding-right:4px; white-space:nowrap;">{{{computed.apStr}}}</span>
        </div>

        <label style="font-weight:bold; font-size:12px; color:#333;">탄약</label>
        <div style="display:flex; gap:5px; align-items:center;">
          <input type="text" name="system.ammo.value" value="{{system.ammo.value}}" style="width:40px; text-align:center; height:24px; font-weight:bold;"/> /
          
          <input type="text" name="system.ammo.max" value="{{system.ammo.max}}" style="width:40px; text-align:center; height:24px; font-weight:bold;" title="기본 최대 장탄수"/>
          
          {{#if computed.ammoMaxBonus}}
            <span style="font-size:11px; font-weight:bold; color:#0056b3;" title="부착물 보너스">(+{{computed.ammoMaxBonus}})</span>
          {{/if}}
        </div>

        <label style="font-weight:bold; font-size:12px; color:#333;">비관통 데미지</label>
        <div style="display:flex; align-items:center; border:1px solid #bbb; background:#fff; border-radius:3px; height:24px;">
          <input type="text" name="system.damageNonPenetrating" value="{{system.damageNonPenetrating}}" style="border:none; background:transparent; width:100%; text-align:center; height:100%; outline:none;"/>
          {{#if computed.damageNonPenBonus}}<span style="font-weight:bold; font-size:11px; padding-right:4px; color:blue; white-space:nowrap;">+ {{computed.damageNonPenBonus}}</span>{{/if}}
        </div>

        <label style="font-weight:bold; font-size:12px; color:#333;">관통 데미지</label>
        <div style="display:flex; align-items:center; border:1px solid #bbb; background:#fff; border-radius:3px; height:24px;">
          <input type="text" name="system.damagePenetrating" value="{{system.damagePenetrating}}" style="border:none; background:transparent; width:100%; text-align:center; height:100%; outline:none;"/>
          {{#if computed.damagePenBonus}}<span style="font-weight:bold; font-size:11px; padding-right:4px; color:blue; white-space:nowrap;">+ {{computed.damagePenBonus}}</span>{{/if}}
        </div>

      </div>

      <h4 style="margin:15px 0 5px 0; font-size:12px; color:#0056b3; border-bottom:1px solid #ccc; padding-bottom:3px;"><i class="fas fa-puzzle-piece"></i> 부착물 (다중 장착 가능 / 아이템 드롭)</h4>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:10px;">
        
        <div class="attachment-slot" data-slot="sight" style="border:1px dashed #999; padding:8px; background:#f4f4f4; border-radius:4px;">
          <div style="font-size:11px; font-weight:bold; color:#666; margin-bottom:4px; text-align:center;">조준경 (상부)</div>
          {{#each safeAttachments.sight as |att index|}}
            <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #ccc; padding:2px 5px; margin-bottom:2px; border-radius:3px; font-size:11px;">
              <span class="attachment-edit" data-id="{{att.id}}" style="font-weight:bold; color:#28a745; cursor:pointer;" title="클릭하여 상세 보기">{{att.name}}</span>
              <a class="remove-attachment" data-slot="sight" data-index="{{index}}" style="color:#dc3545; cursor:pointer;"><i class="fas fa-times"></i></a>
            </div>
          {{/each}}
          <div style="font-size:10px; color:#aaa; text-align:center; margin-top:5px;">여기에 드롭...</div>
        </div>

        <div class="attachment-slot" data-slot="common" style="border:1px dashed #999; padding:8px; background:#f4f4f4; border-radius:4px;">
          <div style="font-size:11px; font-weight:bold; color:#666; margin-bottom:4px; text-align:center;">총기 악세서리 (공통)</div>
          {{#each safeAttachments.common as |att index|}}
            <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #ccc; padding:2px 5px; margin-bottom:2px; border-radius:3px; font-size:11px;">
              <span class="attachment-edit" data-id="{{att.id}}" style="font-weight:bold; color:#28a745; cursor:pointer;" title="클릭하여 상세 보기">{{att.name}}</span>
              <a class="remove-attachment" data-slot="common" data-index="{{index}}" style="color:#dc3545; cursor:pointer;"><i class="fas fa-times"></i></a>
            </div>
          {{/each}}
          <div style="font-size:10px; color:#aaa; text-align:center; margin-top:5px;">여기에 드롭...</div>
        </div>

        <div class="attachment-slot" data-slot="underbarrel" style="border:1px dashed #999; padding:8px; background:#f4f4f4; border-radius:4px;">
          <div style="font-size:11px; font-weight:bold; color:#666; margin-bottom:4px; text-align:center;">총기 악세서리 (하부)</div>
          {{#each safeAttachments.underbarrel as |att index|}}
            <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #ccc; padding:2px 5px; margin-bottom:2px; border-radius:3px; font-size:11px;">
              <span class="attachment-edit" data-id="{{att.id}}" style="font-weight:bold; color:#28a745; cursor:pointer;" title="클릭하여 상세 보기">{{att.name}}</span>
              <a class="remove-attachment" data-slot="underbarrel" data-index="{{index}}" style="color:#dc3545; cursor:pointer;"><i class="fas fa-times"></i></a>
            </div>
          {{/each}}
          <div style="font-size:10px; color:#aaa; text-align:center; margin-top:5px;">여기에 드롭...</div>
        </div>

        <div class="attachment-slot" data-slot="muzzle" style="border:1px dashed #999; padding:8px; background:#f4f4f4; border-radius:4px;">
          <div style="font-size:11px; font-weight:bold; color:#666; margin-bottom:4px; text-align:center;">총구 부착물 (오른쪽)</div>
          {{#each safeAttachments.muzzle as |att index|}}
            <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #ccc; padding:2px 5px; margin-bottom:2px; border-radius:3px; font-size:11px;">
              <span class="attachment-edit" data-id="{{att.id}}" style="font-weight:bold; color:#28a745; cursor:pointer;" title="클릭하여 상세 보기">{{att.name}}</span>
              <a class="remove-attachment" data-slot="muzzle" data-index="{{index}}" style="color:#dc3545; cursor:pointer;"><i class="fas fa-times"></i></a>
            </div>
          {{/each}}
          <div style="font-size:10px; color:#aaa; text-align:center; margin-top:5px;">여기에 드롭...</div>
        </div>

        <div class="attachment-slot" data-slot="magazine" style="border:1px dashed #999; padding:8px; background:#f4f4f4; border-radius:4px;">
          <div style="font-size:11px; font-weight:bold; color:#666; margin-bottom:4px; text-align:center;">탄창</div>
          {{#each safeAttachments.magazine as |att index|}}
            <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #ccc; padding:2px 5px; margin-bottom:2px; border-radius:3px; font-size:11px;">
              <span class="attachment-edit" data-id="{{att.id}}" style="font-weight:bold; color:#28a745; cursor:pointer;" title="클릭하여 상세 보기">{{att.name}}</span>
              <a class="remove-attachment" data-slot="magazine" data-index="{{index}}" style="color:#dc3545; cursor:pointer;"><i class="fas fa-times"></i></a>
            </div>
          {{/each}}
          <div style="font-size:10px; color:#aaa; text-align:center; margin-top:5px;">여기에 드롭...</div>
        </div>

      </div>
    {{/if}}

   {{#if isArmor}}
