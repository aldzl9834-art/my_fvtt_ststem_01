<form class="gundog-sheet vehicle-sheet" autocomplete="off" style="padding:15px; background:#f9f9f9; height:100%; display:flex; flex-direction:column;">
  
  <header class="sheet-header vehicle-header">
    
    <div class="vehicle-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      
      <div class="vehicle-name-overlay">
        <input name="name" type="text" value="{{actor.name}}" placeholder="차량 이름을 입력하세요" />
      </div>
    </div>
    
    <div class="vehicle-basic-info">
      <div class="v-info-panel">
        
        <h2 class="v-info-title"><i class="fas fa-car"></i> 차량 정보</h2>
        
        <div class="v-info-card">
          <div class="v-stat-box">
            <label>카테고리 (차량 종류)</label>
            <input type="text" name="system.category" value="{{system.category}}" placeholder="예: 세단, 장갑차" />
          </div>
          <div class="v-stat-box">
            <label>사이즈</label>
            <input type="text" name="system.size" value="{{system.size}}" placeholder="예: 중형, 대형" />
          </div>
        </div>

        <div class="v-info-card">
          <div class="v-stat-box">
            <label>가격</label>
            <input type="text" class="comma-input" data-field="system.price" value="{{system.price}}" />
          </div>
          <div class="v-stat-box">
            <label class="cost-label" title="클릭하면 차량의 '기본 유지비'를 수정합니다.">유지비 코스트 (최종)</label>
            <input type="text" class="dynamic-cost-input" 
                   data-field="system.maintenanceCost" 
                   data-base="{{system.maintenanceCost}}" 
                   data-computed="{{computed.maintenanceCost}}" 
                   value="{{computed.maintenanceCost}}" 
                   title="클릭하여 차량 기본 유지비 수정" style="color: #dc3545;" />
          </div>
        </div>
        </div>
        
      </div>
    </div>
    
  </header>

  <nav class="sheet-tabs tabs v-tabs" data-group="primary">
    <a class="item v-tab-item" data-tab="profile"><i class="fas fa-car"></i></a>
    <a class="item v-tab-item" data-tab="cargo"><i class="fas fa-box-open"></i></a>
  </nav>

  <section class="sheet-body v-body">
    
    <div class="tab profile" data-group="primary" data-tab="profile">
      
      <h3 class="v-section-title"><i class="fas fa-tachometer-alt"></i> 차량 성능</h3>
      
      <div class="v-perf-grid">
        
        <div class="v-perf-col">
          <label class="v-perf-label v-color-red">내구력 (HP)</label>
          <div class="v-perf-val-box">
            <input type="number" class="v-hp-input" name="system.hp.value" value="{{system.hp.value}}"/>
            <span class="v-separator">/</span>
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-red w-45" data-field="system.hp.max" data-base="{{system.hp.max}}" data-computed="{{computed.hpMax}}" value="{{computed.hpMax}}" title="클릭: 기본값 수정 (부착물 보너스: {{computed.mods.hp}})" />
          </div>
        </div>

        <div class="v-perf-col">
          <label class="v-perf-label v-color-blue">장갑치</label>
          <div class="v-perf-val-box">
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-blue" data-field="system.armor" data-base="{{system.armor}}" data-computed="{{computed.armor}}" value="{{computed.armor}}" title="클릭: 기본값 수정 (부착물 보너스: {{computed.mods.armor}})" />
          </div>
        </div>

        <div class="v-perf-col">
          <label class="v-perf-label v-color-blue">방어치</label>
          <div class="v-perf-val-box">
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-blue" data-field="system.defense" data-base="{{system.defense}}" data-computed="{{computed.defense}}" value="{{computed.defense}}" title="클릭: 기본값 수정 (부착물 보너스: {{computed.mods.defense}})" />
          </div>
        </div>

        <div class="v-perf-col">
          <label class="v-perf-label v-color-green">스피드 (일반/제한)</label>
          <div class="v-perf-val-box">
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-green" data-field="system.speed.normal" data-base="{{system.speed.normal}}" data-computed="{{computed.speedNormal}}" value="{{computed.speedNormal}}" title="클릭: 일반 스피드 수정 (보너스: {{computed.mods.speedNormal}})" />
            <span class="v-separator">/</span>
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-green" data-field="system.speed.limit" data-base="{{system.speed.limit}}" data-computed="{{computed.speedLimit}}" value="{{computed.speedLimit}}" title="클릭: 제한 스피드 수정 (보너스: {{computed.mods.speedLimit}})" />
          </div>
        </div>

        <div class="v-perf-col">
          <label class="v-perf-label v-color-cyan">조작성</label>
          <div class="v-perf-val-box">
            <input type="text" class="dynamic-stat-input v-dynamic-stat v-color-cyan" data-field="system.handling" data-base="{{system.handling}}" data-computed="{{computed.handling}}" value="{{computed.handling}}" title="클릭: 기본값 수정 (부착물 보너스: {{computed.mods.handling}})" />
          </div>
        </div>

      </div>

        <div class="v-attach-grid">
        
        <div class="attachment-slot v-attach-slot" data-slot="top">
          <div class="v-attach-title">상단 (Top)</div>
          {{#each attachments.top as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.top}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot" data-slot="under">
          <div class="v-attach-title">하단 (Under)</div>
          {{#each attachments.under as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.under}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot" data-slot="side">
          <div class="v-attach-title">사이드 (Side)</div>
          {{#each attachments.side as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.side}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot" data-slot="tire">
          <div class="v-attach-title">타이어 (Tire)</div>
          {{#each attachments.tire as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.tire}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot" data-slot="weapon">
          <div class="v-attach-title red-title">무장 (Weapon)</div>
          {{#each attachments.weapon as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name red-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.weapon}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot" data-slot="body">
          <div class="v-attach-title">보디 (Body)</div>
          {{#each attachments.body as |att|}}
            <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true">
              <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
              <div class="v-attach-controls">
                <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete delete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
          {{#unless attachments.body}}<div class="v-attach-empty">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

        <div class="attachment-slot v-attach-slot span-2" data-slot="glass">
          <div class="v-attach-title">유리 (Glass)</div>
          <div class="v-glass-grid">
            {{#each attachments.glass as |att|}}
              <div class="item attachment-item v-attach-item-box" data-item-id="{{att._id}}" draggable="true" style="margin-bottom:0;">
                <span class="item-name item-edit v-attach-name" title="{{att.system.description}}">{{att.name}}</span>
                <div class="v-attach-controls">
                  <a class="item-unequip unequip" title="장착 해제"><i class="fas fa-arrow-down"></i></a>
                  <a class="item-edit edit"><i class="fas fa-edit"></i></a>
                  <a class="item-delete delete"><i class="fas fa-trash"></i></a>
                </div>
              </div>
            {{/each}}
          </div>
          {{#unless attachments.glass}}<div class="v-attach-empty" style="margin-top:5px;">여기에 차량 부착물을 드롭...</div>{{/unless}}
        </div>

      </div>

      <div style="margin-top:10px;">
        <label style="font-weight:bold; font-size:13px; display:block; border-bottom:2px solid #ddd; padding-bottom:4px; margin-bottom:8px; color:#222;">차량 상세 설명 및 특수 효과</label>
        <textarea name="system.description" style="width:100%; height:150px; padding:10px; border:1px solid #ccc; border-radius:4px; resize:vertical; font-family:inherit; font-size:13px; line-height:1.5; background:#fff;">{{system.description}}</textarea>
      </div>

    </div>

    <div class="tab cargo" data-group="primary" data-tab="cargo" style="height:100%;">
      
      <div class="v-cargo-header">
        
        <h3 class="v-cargo-title">
          <span><i class="fas fa-box"></i> 적재량 (차량 인벤토리)</span>
          <div class="v-cargo-vcp-box">
            <input type="number" class="v-cargo-vcp-input" name="system.vcp" value="{{system.vcp}}" />
            <span class="v-cargo-vcp-label">vcp</span>
            <div class="v-cargo-vcp-total">
              총 적재량: <strong>{{computed.totalVcpCells}}</strong> 칸
            </div>
          </div>
        </h3>
        
        <a class="toggle-simplified-weight v-cargo-toggle {{#if system.simplifiedWeightRule}}is-on{{else}}is-off{{/if}}" title="클릭하여 켜기/끄기">
          <i class="fas {{#if system.simplifiedWeightRule}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" style="font-size:16px;"></i> 간이 중량 규칙
        </a>
      </div>

      <div class="v-cargo-layout">
        
        <div class="v-cargo-grid-section">
          
          <div class="v-cargo-ruler-ctrl">
            <label>→ 크기 한계:</label>
            <input type="number" data-field="system.inventoryMax.x" value="{{#if system.inventoryMax.x}}{{system.inventoryMax.x}}{{else}}10{{/if}}" class="sync-input" />
          </div>
          
          <div class="v-cargo-ruler-x">
            {{#each cpColNumbers}}
              <div>{{this}}</div>
            {{/each}}
          </div>

          <div class="v-cargo-grid-row">
            <div class="v-cargo-ruler-y-wrap">
              <div class="v-cargo-ruler-y-title">
                <span>↓ 적재 한계</span>
                <input type="number" data-field="system.inventoryMax.y" value="{{#if system.inventoryMax.y}}{{system.inventoryMax.y}}{{else}}30{{/if}}" class="sync-input" />
              </div>
              <div class="v-cargo-ruler-y-cells">
                {{#each cpRowNumbers}}
                  <div class="{{#if isFifth}}is-fifth{{else}}not-fifth{{/if}}">{{num}}</div>
                {{/each}}
              </div>
            </div>

            <div class="cp-grid-wrapper v-cargo-grid-box">
              <div class="v-cargo-grid-bg">
                {{#each gridCells}}
                  <div class="v-cargo-cell {{#unless isActive}}is-inactive{{/unless}} {{#if isFifthRow}}is-fifth-row{{/if}}"></div>
                {{/each}}
              </div>
              
              {{#each gridItems}}
                <div class="cp-grid-item v-cargo-grid-item" data-item-id="{{id}}" draggable="true" style="left:{{left}}px; top:{{top}}px; width:{{w}}px; height:{{h}}px;">
                  <span>{{gridLabel}}</span>
                </div>
              {{/each}}
            </div>
          </div>
          
          {{#if system.simplifiedWeightRule}}
            <div class="v-cargo-warning">
              <strong><i class="fas fa-check-circle"></i> [간이 중량 규칙 적용 중]</strong> <br> 아이템의 부피(크기)나 상세 배치를 무시하고 총 적재량 수치만으로 계산하여 화물을 적재합니다. (그리드 배치를 생략할 수 있습니다)
            </div>
          {{/if}}

        </div>

        <div class="v-cargo-list-section">
          <div class="unplaced-item-list v-cargo-list-wrap">
            
            <div class="v-cargo-list-header">
              <h4><i class="fas fa-boxes"></i> 보유중인 화물 및 아이템</h4>
              <div class="v-cargo-list-stat">
                현재 적재량: <strong>{{computed.totalCargoCells}}</strong> 칸
              </div>
            </div>
            
            {{#each unplacedItems}}
              <div class="unplaced-item v-cargo-item" data-item-id="{{id}}" draggable="true">
                
                <div class="v-cargo-item-left">
                  <span class="v-cargo-item-badge">{{gridLabel}}</span>
                  <span class="v-cargo-item-name" title="{{name}}">{{name}}</span>
                </div>
                
                <div class="v-cargo-item-right">
                  <span class="v-cargo-item-status {{#if isPlaced}}is-placed{{else}}not-placed{{/if}}">
                    {{#if isPlaced}}적재됨{{else}}{{portX}} x {{portY}}{{/if}}
                  </span>
                  <a class="unplaced-item-delete v-cargo-item-delete" title="영구 삭제"><i class="fas fa-trash"></i></a>
                </div>

              </div>
            {{/each}}
            
            {{#unless unplacedItems}}
              <div style="text-align:center; color:#aaa; font-size:12px; margin-top:30px;">적재된 아이템이 없습니다.</div>
            {{/unless}}
            
          </div>
        </div>

      </div>
    </div>

  </section>
</form>